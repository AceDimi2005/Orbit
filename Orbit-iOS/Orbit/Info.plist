<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.dimitrie.orbit</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>orbit</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_orbit._tcp</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Orbit connects to your PC over your local network to monitor hardware, control Windows, transfer files, share clipboard text and adjust application audio.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Orbit saves downloaded photos and videos from your PC to your iPhone Photo Library when requested.</string>
	<key>NSSiriUsageDescription</key>
	<string>Orbit uses Siri and Shortcuts so you can power on, sleep, or shut down your PC by voice.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>OrbitAppGroupIdentifier</key>
	<string>$(ORBIT_APP_GROUP_IDENTIFIER)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
